{
  "name": "qvac-medpsy-privacy-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first private wellness document RAG workspace powered by QVAC SDK.",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "qvac:smoke": "tsx src/server/smoke.ts",
    "seed": "tsx src/server/seed.ts"
  },
  "dependencies": {
    "@qvac/sdk": "^0.13.5",
    "b4a": "^1.8.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
